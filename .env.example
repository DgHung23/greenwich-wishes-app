# Sao chép file này thành ".env" (cùng thư mục với server.js) rồi sửa các giá trị bên dưới.
# Copy this file to ".env" next to server.js and edit the values.

# Cổng server lắng nghe (reverse proxy sẽ trỏ vào cổng này)
PORT=8780

# Địa chỉ công khai của website, KHÔNG có dấu "/" ở cuối. Bắt buộc đặt khi lên domain thật:
# dùng để tạo link/ảnh khi chia sẻ Facebook và để bật cookie bảo mật (https).
PUBLIC_URL=https://wishes.example.edu.vn

# Mật khẩu bí mật để mở chế độ admin (gõ vào ô tìm kiếm rồi bấm Ctrl+Alt+X).
# !!! BẮT BUỘC ĐỔI trước khi công khai. Dùng cụm dài, khó đoán (ví dụ 4-5 từ ngẫu nhiên). !!!
# Nếu để nguyên giá trị CHANGE-ME bên dưới, server sẽ TỪ CHỐI khởi động khi PUBLIC_URL là https.
ADMIN_PASSPHRASE=CHANGE-ME-use-a-long-random-phrase

# Đặt 1 khi chạy sau nginx / Caddy / Cloudflare (để lấy đúng IP người dùng cho giới hạn tốc độ)
TRUST_PROXY=1

# Nơi lưu database + ảnh. Mặc định ./data. Nhớ sao lưu thư mục này.
DATA_DIR=./data

# Chỉ dùng khi muốn thử: nạp 420 lời chúc mẫu vào database RỖNG. KHÔNG bật khi chạy thật.
SEED_DEMO=1

# Cấu hình PostgreSQL trên Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=greenwich_wishes
POSTGRES_PORT=5432

# Chuỗi kết nối PostgreSQL:
# - Khi chạy trực tiếp ngoài máy (host): localhost:5432
# - Khi chạy container trong docker-compose: db:5432 (tự động cấu hình trong docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/greenwich_wishes
